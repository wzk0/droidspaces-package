From 6d457c8c534c17af15ca80064f6d10646be973a5 Mon Sep 17 00:00:00 2001
From: thdbd <thdbd@localhost>
Date: Sun, 15 Nov 2026 16:30:33 +0800
Subject: [PATCH 2/2] =?UTF-8?q?fix(gnome):=20Fedora=2045=20=E7=94=A8=20rpm?=
 =?UTF-8?q?=20-K=20--nosignature=20=E6=A0=A1=E9=AA=8C=E4=BA=A7=E7=89=A9?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Fedora 45 把 %_pkgverify_level 提到 all，未签名的本地 rpmbuild 产物会被
rpm -K 判为 SIGNATURES NOT OK 而使构建失败；改为只校验摘要。
---
 producers/gnome/Fedora45_v5/build.sh | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/producers/gnome/Fedora45_v5/build.sh b/producers/gnome/Fedora45_v5/build.sh
index 694a183..6d7252c 100644
--- a/producers/gnome/Fedora45_v5/build.sh
+++ b/producers/gnome/Fedora45_v5/build.sh
@@ -94,7 +94,9 @@ fedora_publish_rpm() {
     local file=$1 destination="$ARTIFACTS_DIR/${1##*/}" architecture
     architecture=$(rpm -qp --qf '%{ARCH}' "$file") || fedora_die 'RPM architecture'
     [[ $architecture == aarch64 || $architecture == noarch ]] || fedora_die "wrong architecture: $file"
-    fedora_run rpm -K "$file"
+    # Fedora 45 的 %_pkgverify_level 为 all，未签名包会让 rpm -K 失败；
+    # 这里只校验摘要，签名由仓库侧负责。
+    fedora_run rpm -K --nosignature "$file"
     fedora_run rpm -qpl "$file" >/dev/null
     [[ ! -e $destination.sig && ! -L $destination.sig ]] || cmp -s "$file" "$destination" || fedora_die "existing signature preserved: $destination.sig"
     fedora_run cp -p -- "$file" "$destination"
-- 
